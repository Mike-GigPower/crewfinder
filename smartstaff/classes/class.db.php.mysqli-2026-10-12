		/**
    	* load database connection
    	*
    	* @return null
    	*/
    
						function connect()
		{
			
			mysqli_report(MYSQLI_REPORT_OFF);
			
			if($connect = mysqli_connect($this->server, $this->username, $this->password, $this->database))
				$this->connection = $connect;
			else
				$this->errors->addError('CONNECT: '. mysqli_connect_error());
			
		}
		
		/**
    	* select database
   	 	*
    	* No-op since the mysqli conversion — mysqli_connect() selects the database
    	* via its fourth argument. Kept because __construct() calls it at line 122.
    	*
    	* @return null
    	*/
    
		function selectDB()
		{
			
		}
		
		/**
    	* insert data into a table
    	*
    	* IMPORTANT: data sanitisation is not performed here
    	*	@see sc()
    	*
    	* @param table				name of the table to work with
    	* @param username 		array of data to insert (field => value)
    	* @return null
    	*/
    
		function insert($table, $data)
		{
			
			/*
			/* iterate through data */

			if(count($data) > 0)
			{
				
				/*
				/* format and run query */
				
				$query = "INSERT INTO `". $table ."` (". '`'. implode('`,`', array_keys($data)) . '`' .") VALUES (". implode(',', array_values($data)) .")";

				mysqli_query($this->connection, $query);
				
				/*
				/* register query */
				
				$this->queryCount++;
				$this->affected_rows = mysqli_affected_rows($this->connection);
				
				/*
				/* debug data */
				
				if($this->debug == 1)
				{
					
					$this->errors->addError(mysqli_error($this->connection));
					$this->debug($query);
					
				}
				
			}
			
		}
		
		/**
    	* update table data
    	*
    	* @param table				name of the table to work with
    	* @param username 		array of data to insert
    	* @param where		 		where conditions
    	* @return null
    	*/
    
		function update($table, $data, $where = NULL)
		{

			/*
			/* handle multiple tables - joins don't work */

			$tables = explode(',', $table);
			foreach ($tables as &$t)
				$t = '`' . trim($t) . '`';
			$tables = implode(', ', $tables);
			
			if(count($data) > 0)
			{
			
				/*
				/* iterate through data */
				
				$fields = array();
				foreach($data as $field => $value)
				{
					/*
					/* handle fully qualified field names */

					$field = explode('.', $field);
					foreach ($field as &$f)
						$f = '`' . trim($f) . '`';
					$field = implode('.', $field);

					$fields[] = $field .'='. $value;
				}
	
				/*
				/* build query */
				
				$query = 'UPDATE '. $tables .' SET '. implode(', ', $fields);
				
				/*
				/* add where condition if needed */
				
				if($where != NULL)
					$query .= ' WHERE '. $where;
					
				/*
				/* execute query */
					
				mysqli_query($this->connection, $query);
				
				/*
				/* register query */
				
				$this->queryCount++;
				$this->affected_rows = mysqli_affected_rows($this->connection);
				
				/*
				/* debug data */
				
				if($this->debug == 1)
				{
					
					$this->errors->addError(mysqli_error($this->connection));
					$this->debug($query);
					
				}
			
			}

		}
		
		/**
    	* select data from a table
   		*
    	* @param fields				fields to select
    	* @param table	 			table to use
    	* @param conditions		where conditions
    	* @param order				which fields to order by
    	* @param limit				how many rows to return
    	* @access public
    	* @return array of mock objects
    	*/
		
		function select($fields='*', $table = NULL, $conditions = NULL, $order = NULL, $limit = NULL)
		{
			
			/*
			/* build query */
			
			$query = 'SELECT '. $fields;
			
			/*
			/* table (allows for mysql server vars to be called) */
			
			if($table != NULL)
				$query .= ' FROM '. $table;
			
			/*
			/* where conditions, if needed */
			
			if($conditions != NULL)
				$query .= ' WHERE '. $conditions;
				
			/*
			/* order, if needed */
				
			if($order != NULL)
				$query .= ' ORDER BY '. $order;
			
			/*
			/* limit result set, if needed */
				
			if($limit != NULL)
				$query .= ' LIMIT '. $limit;
				
			/*
			/* execute query */
				
			$result = mysqli_query($this->connection, $query);
			
			/*
			/* register query */
			
			$this->queryCount++;
			$this->affected_rows = mysqli_affected_rows($this->connection);
			
			/*
			/* debug data */
			
			if($this->debug == 1)
			{
				
				$this->errors->addError(mysqli_error($this->connection), __FILE__, __LINE__);
				$this->debug($query);
				
			}
			
			/*
			/* if a result was returned */
			
			$result_set = null;
			
			if($this->affected_rows > 0)
							while($row = mysqli_fetch_object($result))
					$result_set[] = $row;

			return $result_set;
			
		}
		
		/**
    	* select first row from a table
    	*
    	* @param fields				fields to select
    	* @param table	 			table to use
    	* @param conditions		where conditions
    	* @param order				which fields to order by
    	* @param limit				how many rows to return
    	* @access public
    	* @return mock object
    	*/
		
		function selectFirst($fields='*', $table = NULL, $conditions = NULL, $order = NULL)
		{
			
			/*
			/* select using select function */
			
			$result = $this->select($fields, $table, $conditions, $order, 1);
			
			/*
			/* if we have a result */
			
			if($result)
				return $result[0];
			else
				return false;
				
		}
		
		/**
    	* delete from a table
    	*
    	* @param table	 			table to use
    	* @param conditions		where conditions
    	* @access public
    	* @return null
    	*/
		
		function delete($table, $where)
		{
			
			/*
			/* execute query */
			
			mysqli_query($this->connection, "DELETE FROM `". $table ."` WHERE ". $where);
			
			/*
			/* register query */

			$this->queryCount++;
			$this->affected_rows = mysqli_affected_rows($this->connection);

			if($this->debug == 1)
			{
				$this->error = mysqli_error($this->connection);
				$this->debug("DELETE FROM `". $table ."` WHERE ". $where);
			}

		}
		
		/**
	    * run a raw query
	    *
	    * @access public
	    * @return bool
	    */
	    
	    function rawSql($query)
	    {
		    mysqli_query($this->connection, $query);

		    $this->queryCount++;

		    if($this->debug == 1)
		    {
			    $this->error = mysqli_error($this->connection);
			    $this->debug($query);
		    }
	    }
		
		/**
    	* get last inserted IDs
    	*
    	* @access public
