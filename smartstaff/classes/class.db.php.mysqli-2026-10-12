		 */
		
		var $errors;
		
		/**
		 * mysql debug variable
		 * @var int
		 */

		var $debug = 0;
		
		/**
		 * keeps track of how many queries have been run
		 * @var int
		 */

		var $queryCount = 0;

		/**
		 * rows affected by the last query run through this class
		 *
		 * Set by insert(), update(), delete() and select(). Previously assigned
		 * dynamically by select() alone; PHP 8.2 deprecated dynamic properties
		 * and PHP 9 will reject them, so it is declared here.
		 *
		 * TRAP: select() overwrites this. A selectFirst() between a write and
		 * the read will clobber it, so read it IMMEDIATELY after the write.
		 *
		 * @var int
		 */

		var $affected_rows = 0;

		/**
		 * last error text, set only when debug is on
		 * @var string
		 */

		var $error;
	
