	   		echo('
	    
	   		<div style="width: 500px; padding: 10px; margin: 10px; font-size: 10px; font-family: tahoma; border: 1px solid #ccc;">
	    		<p><b>Query:</b> '. $query .'</p>
	    		<p><b>Error:</b> '. mysqli_error($this->connection) .'</p>
	   		</div>
	    
	    	');
	    
    	}
    
    	/**
    	* cleans form data
    	*
    	* @param  string  			input
    	* @param  int			 			autoquote values
    	* @access public
    	*/
    
    	function sc($string, $dbprepare=1)
    	{
	    
	    	/*
			/* remove gay magic quotes */
	    
	    			/* magic_quotes was removed in PHP 8 and has been off since 5.4,
		   so there is nothing to strip */
	    	
	    	/*
			/* escape data ready for mysql */
			
			$string = mysqli_real_escape_string($this->connection, $string);
			
			/*
			/* if autoquoting is needed */
			
			if($dbprepare == 1)
			{
				
				if(!is_numeric($string))
					$string = "'". $string ."'";
					
			}
			
	    	return $string;
	    
    	}

	}
	
